{
    "name": "alexfigures/example-jsonapi-bundle",
    "description": "Real Symfony JSON:API usage example and HTTP black-box acceptance application",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "alexfigures/symfony-jsonapi-bundle": "dev-fix/acceptance-gaps",
        "doctrine/doctrine-bundle": "^2.19.1",
        "doctrine/orm": "^3.7.2",
        "symfony/console": "7.3.*",
        "symfony/dotenv": "7.3.*",
        "symfony/flex": "^2.11.0",
        "symfony/framework-bundle": "7.3.*",
        "symfony/property-access": "7.3.*",
        "symfony/property-info": "7.3.*",
        "symfony/runtime": "7.3.*",
        "symfony/serializer": "7.3.*",
        "symfony/string": "7.3.*",
        "symfony/uid": "7.3.*",
        "symfony/validator": "7.3.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "symfony/browser-kit": "7.3.*",
        "symfony/css-selector": "7.3.*",
        "symfony/phpunit-bridge": "^7.4.18",
        "phpunit/phpunit": "^11.5.56"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test:stable": "phpunit --exclude-group bundle-gap",
        "test:full": "phpunit",
        "test:gaps": "phpunit --group bundle-gap",
        "acceptance:report": "php tools/acceptance-report.php",
        "test:extreme": "phpunit -c phpunit.torture.xml.dist --testsuite extreme",
        "test:performance": "phpunit -c phpunit.torture.xml.dist --testsuite performance",
        "test:chaos": "phpunit -c phpunit.torture.xml.dist --testsuite chaos",
        "test:torture:stable": "phpunit -c phpunit.torture.xml.dist --exclude-group torture-gap",
        "test:torture:full": "phpunit -c phpunit.torture.xml.dist --log-junit var/torture/junit.xml",
        "test:torture:gaps": "phpunit -c phpunit.torture.xml.dist --group torture-gap",
        "torture:report": "php tools/torture-report.php"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.3.*"
        }
    }
}
