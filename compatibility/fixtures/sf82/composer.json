{
  "name": "alexfigures/example-jsonapi-bundle",
  "description": "Real Symfony JSON:API usage example and HTTP black-box acceptance application",
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "alexfigures/symfony-jsonapi-bundle": "1.0.0-RC",
    "doctrine/dbal": "^4.5",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/orm": "^3.7.2",
    "symfony/console": "8.2.*@dev",
    "symfony/dotenv": "8.2.*@dev",
    "symfony/flex": "^2.11.0",
    "symfony/framework-bundle": "8.2.*@dev",
    "symfony/property-access": "8.2.*@dev",
    "symfony/property-info": "8.2.*@dev",
    "symfony/runtime": "8.2.*@dev",
    "symfony/serializer": "8.2.*@dev",
    "symfony/string": "8.2.*@dev",
    "symfony/uid": "8.2.*@dev",
    "symfony/validator": "8.2.*@dev",
    "symfony/yaml": "8.2.*@dev"
  },
  "require-dev": {
    "symfony/browser-kit": "8.2.*@dev",
    "symfony/css-selector": "8.2.*@dev",
    "symfony/phpunit-bridge": "8.2.*@dev",
    "phpunit/phpunit": "^11.5.56"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "bump-after-update": false,
    "platform": {
      "php": "8.4.26"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "test:stable": "phpunit --exclude-group bundle-gap",
    "test:full": "phpunit",
    "test:gaps": "phpunit --group bundle-gap",
    "acceptance:report": "php tools/acceptance-report.php",
    "test:extreme": "phpunit -c phpunit.torture.xml.dist --testsuite extreme",
    "test:performance": "phpunit -c phpunit.torture.xml.dist --testsuite performance",
    "test:chaos": "phpunit -c phpunit.torture.xml.dist --testsuite chaos",
    "test:torture:stable": "phpunit -c phpunit.torture.xml.dist --exclude-group torture-gap",
    "test:torture:full": "phpunit -c phpunit.torture.xml.dist --log-junit var/torture/junit.xml",
    "test:torture:gaps": "phpunit -c phpunit.torture.xml.dist --group torture-gap",
    "torture:report": "php tools/torture-report.php",
    "test:production": "phpunit tests/Acceptance/Production --exclude-group bundle-gap",
    "test:production:full": "phpunit tests/Acceptance/Production",
    "test:production:gaps": "phpunit tests/Acceptance/Production --group bundle-gap",
    "test:features": "phpunit tests/Acceptance/Features",
    "test:features:gaps": "phpunit tests/Acceptance/Features --group bundle-gap",
    "features:inventory": "php tools/public-feature-inventory.php"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.2.*"
    }
  }
}
