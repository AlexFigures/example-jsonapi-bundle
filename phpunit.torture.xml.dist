<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php" colors="true" cacheDirectory="var/torture/phpunit" failOnWarning="true" failOnRisky="true">
    <testsuites>
        <testsuite name="extreme"><directory>tests/Torture/Extreme</directory></testsuite>
        <testsuite name="performance"><directory>tests/Torture/Performance</directory></testsuite>
        <testsuite name="chaos"><directory>tests/Torture/Chaos</directory></testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="torture" force="true"/>
        <env name="APP_DEBUG" value="0" force="true"/>
        <env name="KERNEL_CLASS" value="App\Kernel"/>
    </php>
</phpunit>
